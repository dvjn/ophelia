+void LocationBarView::StartNewTabSearch(NewTabSearch new_tab_search) {
+  const bool in_progress = this->new_tab_search().has_value();
+  set_new_tab_search(new_tab_search);
+  if (in_progress) {
+    // Keep what was typed, selected.
+    FocusLocation(/*is_user_initiated=*/true, /*clear_focus_if_failed=*/false);
+    return;
+  }
+  omnibox_view_->SetUserText(std::u16string(), /*update_popup=*/false);
+  FocusLocation(/*is_user_initiated=*/true, /*clear_focus_if_failed=*/false);
+  // Focusing doesn't ask for suggestions while input is in progress.
+  GetOmniboxController()->edit_model()->StartZeroSuggestRequest(
+      /*user_clobbered_permanent_text=*/true);
+}
+
+void LocationBarView::CancelNewTabSearch() {
+  if (!new_tab_search()) {
+    return;
+  }
+  set_new_tab_search(std::nullopt);
+  omnibox_view_->RevertAll();
+}
