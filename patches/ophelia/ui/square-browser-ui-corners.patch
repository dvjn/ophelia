+// Copyright 2026 The Ophelia Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/renderer/square_corners_observer.h"
+
+#include "base/command_line.h"
+#include "chrome/common/chrome_switches.h"
+#include "content/public/common/url_constants.h"
+#include "content/public/renderer/render_frame.h"
+#include "third_party/blink/public/platform/web_string.h"
+#include "third_party/blink/public/web/web_document.h"
+#include "third_party/blink/public/web/web_local_frame.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr char kSquareCornersStyleSheet[] =
+    "*, ::before, ::after { border-radius: 0 !important; }";
+
+bool IsInternalPage(const GURL& url) {
+  return url.SchemeIs(content::kChromeUIScheme) ||
+         url.SchemeIs(content::kHeliumUIScheme) ||
+         url.SchemeIs(content::kChromeUIUntrustedScheme) ||
+         url.SchemeIs(content::kChromeDevToolsScheme);
+}
+
+}  // namespace
+
+SquareCornersObserver::SquareCornersObserver(content::RenderFrame* render_frame)
+    : content::RenderFrameObserver(render_frame) {}
+
+SquareCornersObserver::~SquareCornersObserver() = default;
+
+void SquareCornersObserver::DidCreateDocumentElement() {
+  if (!ShouldSquareCorners()) {
+    return;
+  }
+  render_frame()->GetWebFrame()->GetDocument().InsertStyleSheet(
+      blink::WebString::FromASCII(kSquareCornersStyleSheet), nullptr,
+      blink::WebCssOrigin::kUser);
+}
+
+void SquareCornersObserver::OnDestruct() {
+  delete this;
+}
+
+bool SquareCornersObserver::ShouldSquareCorners() const {
+  GURL url = render_frame()->GetWebFrame()->GetDocument().Url();
+  if (IsInternalPage(url)) {
+    return base::CommandLine::ForCurrentProcess()->HasSwitch(
+        switches::kSquareUiCorners);
+  }
+  return false;
+}
