+// Copyright 2026 The Ophelia Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_RENDERER_SQUARE_CORNERS_OBSERVER_H_
+#define CHROME_RENDERER_SQUARE_CORNERS_OBSERVER_H_
+
+#include "content/public/renderer/render_frame_observer.h"
+
+// Removes rounded corners from a frame's documents with a user stylesheet,
+// which beats the page's own !important rules and also applies inside shadow
+// trees. Internal pages follow the square browser UI pref.
+class SquareCornersObserver : public content::RenderFrameObserver {
+ public:
+  explicit SquareCornersObserver(content::RenderFrame* render_frame);
+  SquareCornersObserver(const SquareCornersObserver&) = delete;
+  SquareCornersObserver& operator=(const SquareCornersObserver&) = delete;
+  ~SquareCornersObserver() override;
+
+  // content::RenderFrameObserver:
+  void DidCreateDocumentElement() override;
+  void OnDestruct() override;
+
+ private:
+  bool ShouldSquareCorners() const;
+};
+
+#endif  // CHROME_RENDERER_SQUARE_CORNERS_OBSERVER_H_
