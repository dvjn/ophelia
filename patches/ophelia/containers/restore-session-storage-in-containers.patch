+// Returns the sessionStorage namespace of `web_contents`' own
+// StoragePartition, which isn't the default one for a tab with a fixed
+// partition, like a container tab.
+content::SessionStorageNamespaceHandle* GetSessionStorageNamespace(
+    content::WebContents* web_contents) {
+  const content::StoragePartitionConfig& config =
+      web_contents->GetBrowserContext()
+          ->GetStoragePartition(web_contents->GetSiteInstance())
+          ->GetConfig();
+  const content::SessionStorageNamespaceHandleMap& namespaces =
+      web_contents->GetController().GetSessionStorageNamespaceMap();
+  auto it = namespaces.find(config);
+  return it != namespaces.end()
+             ? it->second.get()
+             : web_contents->GetController().GetDefaultSessionStorageNamespace();
+}
