+void ContainersHandler::HandleGetRemoveContainerMessage(
+    const base::ListValue& args) {
+  AllowJavascript();
+  const std::string* id = args[1].GetIfString();
+  const int tab_count =
+      id ? static_cast<int>(GetContainerTabs(profile_, *id).size()) : 0;
+  ResolveJavascriptCallback(
+      args[0], base::Value(l10n_util::GetPluralStringFUTF16(
+                   IDS_SETTINGS_CONTAINERS_REMOVE_MESSAGE, tab_count)));
+}
+
 void ContainersHandler::HandleRemoveContainer(const base::ListValue& args) {
-  if (const std::string* id = args[0].GetIfString()) {
-    service_->RemoveContainer(*id);
+  const std::string* id = args[0].GetIfString();
+  if (!id || !service_->GetContainer(*id)) {
+    return;
+  }
+  // Close the tabs first, so that nothing uses the site data being deleted.
+  for (tabs::TabInterface* tab : GetContainerTabs(profile_, *id)) {
+    tab->Close();
   }
+  service_->RemoveContainer(*id);
+  // Nothing is left to attribute to the container: its tabs are closed, can't
+  // be restored, and its data is deleted.
+  service_->ForgetUsedContainer(*id);
+  containers::DeleteContainerData(profile_, *id);
 }
 
