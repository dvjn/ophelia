+// Returns the open tabs of the container with `container_id`, in all of
+// `profile`'s windows.
+std::vector<tabs::TabInterface*> GetContainerTabs(
+    Profile* profile,
+    std::string_view container_id) {
+  std::vector<tabs::TabInterface*> tabs;
+  ProfileBrowserCollection::GetForProfile(profile)->ForEach(
+      [&](BrowserWindowInterface* browser) {
+        for (tabs::TabInterface* tab : *browser->GetTabStripModel()) {
+          if (containers::GetContainerIdForWebContents(tab->GetContents()) ==
+              container_id) {
+            tabs.push_back(tab);
+          }
+        }
+        return true;
+      });
+  return tabs;
+}
+
