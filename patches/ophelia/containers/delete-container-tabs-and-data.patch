+void DeleteContainerData(Profile* profile, std::string_view container_id) {
+  content::StoragePartition* partition = profile->GetStoragePartition(
+      GetStoragePartitionConfigForContainer(profile, container_id));
+
+  partition->ClearData(content::StoragePartition::REMOVE_DATA_MASK_ALL,
+                       /*filter_builder=*/nullptr,
+                       /*storage_key_policy_matcher=*/base::NullCallback(),
+                       network::mojom::CookieDeletionFilter::New(),
+                       /*perform_storage_cleanup=*/true, base::Time(),
+                       base::Time::Max(), base::DoNothing());
+  partition->GetNetworkContext()->ClearHttpCache(
+      base::Time(), base::Time::Max(), /*filter=*/nullptr, base::DoNothing());
+
+  // Removing a zoom level also removes it from the profile's prefs.
+  content::HostZoomMap::GetForStoragePartition(partition)->ClearZoomLevels(
+      base::Time(), base::Time::Max());
+
+  // The partition is loaded now, so its directory can only go once the
+  // browser restarts: StoragePartition garbage collection then deletes every
+  // directory that no container, app or extension still uses.
+  profile->GetPrefs()->SetBoolean(
+      ::prefs::kShouldGarbageCollectStoragePartitions, true);
+}
