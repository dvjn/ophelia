 // Notification Id is of the following format:
 // p[b]#<origin>#[1|0][<developer_tag>|persistent_notification_id]
+// static
+std::optional<StoragePartitionConfig>
+NotificationIdGenerator::GetStoragePartitionConfigForPersistentNotification(
+    BrowserContext* browser_context,
+    std::string_view notification_id) {
+  if (!IsPersistentNotification(notification_id)) {
+    return std::nullopt;
+  }
+  notification_id.remove_prefix(1);
+  if (notification_id.starts_with(kNotificationShownByBrowserFlag)) {
+    notification_id.remove_prefix(1);
+  }
+  if (!notification_id.starts_with(kStoragePartitionFlag)) {
+    return std::nullopt;
+  }
+  notification_id.remove_prefix(1);
+  notification_id = notification_id.substr(
+      0, notification_id.find(kNotificationTagSeparator));
+
+  std::vector<std::string_view> parts = base::SplitStringPiece(
+      notification_id, std::string_view(&kStoragePartitionNameSeparator, 1),
+      base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+  std::string partition_domain;
+  std::string partition_name;
+  if (parts.size() != 2 || parts[0].empty() ||
+      !base::HexStringToString(parts[0], &partition_domain) ||
+      !base::HexStringToString(parts[1], &partition_name)) {
+    return std::nullopt;
+  }
+  return StoragePartitionConfig::Create(browser_context, partition_domain,
+                                        partition_name, /*in_memory=*/false);
+}
+
+void NotificationIdGenerator::SetStoragePartitionConfig(
+    const StoragePartitionConfig& config) {
+  if (config.is_default() || config.in_memory()) {
+    storage_partition_segment_.clear();
+    return;
+  }
+  storage_partition_segment_ =
+      kStoragePartitionFlag +
+      base::HexEncode(base::as_byte_span(config.partition_domain())) +
+      kStoragePartitionNameSeparator +
+      base::HexEncode(base::as_byte_span(config.partition_name()));
+}
