+bool IsContainerStoragePartitionPath(
+    const base::FilePath& relative_partition_path) {
+  // Content keeps the StoragePartitions of a partition domain together in a
+  // directory named after the domain: Storage/ext/<domain>/<hashed name>.
+  return relative_partition_path.DirName().BaseName() ==
+         base::FilePath::FromASCII(kContainersStoragePartitionDomain);
+}
