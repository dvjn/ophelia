+void SetSavedTabContainer(content::WebContents* contents,
+                          const std::string& saved_tab_guid) {
+  ScopedDictPrefUpdate update(
+      Profile::FromBrowserContext(contents->GetBrowserContext())->GetPrefs(),
+      prefs::kSavedTabContainers);
+  if (std::optional<std::string> container_id =
+          GetContainerIdForWebContents(contents)) {
+    update->Set(saved_tab_guid, *container_id);
+  } else {
+    update->Remove(saved_tab_guid);
+  }
+}
+
+SavedTabContainer GetSavedTabContainer(Profile* profile,
+                                       const std::string& saved_tab_guid) {
+  const std::string* container_id =
+      profile->GetPrefs()
+          ->GetDict(prefs::kSavedTabContainers)
+          .FindString(saved_tab_guid);
+  if (!container_id) {
+    return {};
+  }
+  std::optional<content::StoragePartitionConfig> config =
+      FindContainerStoragePartition(profile, *container_id);
+  return {.can_open = config.has_value(), .storage_partition_config = config};
+}
+
+void ForgetOtherSavedTabContainers(
+    Profile* profile,
+    const std::set<std::string>& saved_tab_guids) {
+  ScopedDictPrefUpdate update(profile->GetPrefs(), prefs::kSavedTabContainers);
+  std::vector<std::string> to_remove;
+  for (const auto [guid, value] : *update) {
+    if (!saved_tab_guids.contains(guid)) {
+      to_remove.push_back(guid);
+    }
+  }
+  for (const std::string& guid : to_remove) {
+    update->Remove(guid);
+  }
+}
