+ContainerIndicatorRepainter::ContainerIndicatorRepainter(views::View* tab_view)
+    : tab_view_(tab_view) {}
+
+ContainerIndicatorRepainter::~ContainerIndicatorRepainter() = default;
+
+void ContainerIndicatorRepainter::ObserveContainersOf(
+    const tabs::TabInterface* tab) {
+  if (observation_.IsObserving() || !tab || !tab->GetContents()) {
+    return;
+  }
+  if (containers::ContainersService* service =
+          containers::ContainersServiceFactory::GetForProfile(
+              Profile::FromBrowserContext(
+                  tab->GetContents()->GetBrowserContext()))) {
+    observation_.Observe(service);
+  }
+}
+
+void ContainerIndicatorRepainter::OnContainersChanged() {
+  tab_view_->SchedulePaint();
+}
