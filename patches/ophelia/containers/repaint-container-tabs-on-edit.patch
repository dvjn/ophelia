+// Repaints a tab view when the containers of its profile change, so that its
+// container indicator shows a recoloured container right away. The view
+// otherwise only repaints when its own tab changes.
+class ContainerIndicatorRepainter
+    : public containers::ContainersService::Observer {
+ public:
+  explicit ContainerIndicatorRepainter(views::View* tab_view);
+  ContainerIndicatorRepainter(const ContainerIndicatorRepainter&) = delete;
+  ContainerIndicatorRepainter& operator=(const ContainerIndicatorRepainter&) =
+      delete;
+  ~ContainerIndicatorRepainter() override;
+
+  // Starts observing the containers of `tab`'s profile, if it doesn't yet.
+  // Call it when painting the tab view.
+  void ObserveContainersOf(const tabs::TabInterface* tab);
+
+  // containers::ContainersService::Observer:
+  void OnContainersChanged() override;
+
+ private:
+  const raw_ptr<views::View> tab_view_;
+  base::ScopedObservation<containers::ContainersService,
+                          containers::ContainersService::Observer>
+      observation_{this};
+};
+
 #endif  // CHROME_BROWSER_UI_VIEWS_TABS_CONTAINER_INDICATOR_H_
