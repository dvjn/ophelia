+#include "chrome/browser/containers/container_data.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "components/containers/content/browser/storage_partition_utils.h"
+#include "components/containers/core/browser/prefs.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/storage_partition.h"
+
+namespace containers {
+
+std::unordered_set<base::FilePath> GetContainerStoragePartitionPaths(
+    Profile* profile) {
+  std::unordered_set<base::FilePath> paths;
+  // Read the prefs rather than the service, which doesn't exist while
+  // containers are off, so that their data is kept for when they're back on.
+  for (const mojom::ContainerPtr& container :
+       GetContainersFromPrefs(*profile->GetPrefs())) {
+    paths.insert(profile
+                     ->GetStoragePartition(GetStoragePartitionConfigForContainer(
+                         profile, container->id))
+                     ->GetPath());
+  }
+  return paths;
+}
+
+}  // namespace containers
